# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:3000

# JWT Secret (generate a secure random string)
JWT_SECRET=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=mysql://username:password@localhost:3306/outbox

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Elasticsearch Configuration (optional)
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Slack OAuth Configuration (optional)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback

# Worker Configuration
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# SMTP Configuration
# Note: Ethereal SMTP credentials are auto-generated per sender
# No need to configure SMTP credentials - they are created automatically
